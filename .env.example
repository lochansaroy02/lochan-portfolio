# Base URL of the FastAPI chatbot backend (portfolio-ai).
# Local dev: http://127.0.0.1:8000
# Production: the public URL of your deployed FastAPI service.
# Server-side only, so it is never exposed to the browser.
AI_API_URL=http://127.0.0.1:8000

# Gmail account used by the contact form (/api/email).
# EMAIL_PASS must be a Google App Password, not your account password.
EMAIL_USER=
EMAIL_PASS=
